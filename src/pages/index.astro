---
import Base from '../layouts/Base.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Logo from '../components/Logo.astro';
import { org, ticker, upcoming, results, teams, timeline, creators } from '../data/site';
const loop = [...ticker, ...ticker];
const next = upcoming[0];
const nextTeam = teams.find((t) => t.name === next.team);
const queue = upcoming.slice(0, 6);
const latest = results.slice(0, 5);
const news = timeline.slice(0, 3);
---
<Base>
  <section class="hero">
    <Logo class="hero-mark" />
    <div class="hero-inner">
      <span class="kicker upper">{org.descriptor}</span>
      <h1>Developing talent. <em>Winning together.</em></h1>
      <p class="lede">{org.intro}</p>
      <div class="actions">
        <a class="btn blue" href="/join">Work with us ↗</a>
        <a class="btn ghost" href="/team">View roster ↗</a>
      </div>
    </div>
  </section>

  <div class="ticker" aria-label="Players">
    <div class="ticker-track">{loop.map((p) => <span>{p}</span>)}</div>
  </div>

  <div class="section-head">
    <h2>Our Teams</h2>
    <a class="more" href="/team">Show teams</a>
  </div>
  <TeamGrid />

  <section class="match-split">
    <div class="match-col">
      <header><h2>Upcoming</h2><a class="more" href="/matches" style="color:#7d9bff">All matches</a></header>
      <div class="next">
        <div class="meta"><span>{next.team}</span><span>{next.display}</span></div>
        <div class="versus">
          <div class="side"><div class="crest"><img src={nextTeam?.image} alt="" width="84" height="84" /></div>{next.team}</div>
          <div><div class="vs">VS</div><div class="ev">{next.event}</div></div>
          <div class="side"><div class="crest opp">{next.opponent[0]}</div>{next.opponent}</div>
        </div>
        <div class="countdown" data-start={next.date} aria-live="off"></div>
      </div>
      <div class="queue">
        {queue.map((m) => <div>{m.team.split(' ')[0]} · {m.display.slice(0, 6)}</div>)}
      </div>
    </div>
    <div class="match-col">
      <header><h2>Results</h2><a class="more" href="/matches" style="color:#7d9bff">All results</a></header>
      {latest.map((m) => (
        <div class="result">
          <div><h3>{m.team} vs {m.opponent}</h3><p>{m.event} · {m.display}</p></div>
          <span class={`tag ${m.result ? m.result.toLowerCase() : 'na'}`}>{m.result ?? '–'}</span>
        </div>
      ))}
    </div>
  </section>

  <div class="section-head">
    <h2>Latest News</h2>
    <a class="more" href="/timeline">Show all</a>
  </div>
  <div class="news">
    {news.map((n) => (
      <article>
        <div class="pic"><span class="t">{n.tag}</span><span class="y">{n.month ?? ''} {n.year}</span></div>
        <h3>{n.title}</h3>
        <p class="excerpt">{n.text.slice(0, 120)}…</p>
      </article>
    ))}
  </div>

  <div class="section-head">
    <h2>Creators</h2>
    <a class="more" href="/content">Live &amp; content</a>
  </div>
  <div class="grid g3" style="grid-template-columns:repeat(auto-fit,minmax(200px,260px))">
    {creators.map((c) => (
      <a class="card" href={c.links[0].href} target="_blank" rel="noopener">
        <div class="thumb" style="aspect-ratio:1"><img src={c.image} alt="" width="640" height="640" /><b>{c.name}</b></div>
        <div class="name">{c.name}</div><div class="sub">{c.game} · {c.links.map((l) => l.label).join(' / ')}</div>
      </a>
    ))}
  </div>

  <section class="cta">
    <h2>Want to join Imprerial Law?</h2>
    <p>We are always looking for ambitious players, coaches, creatives and staff. Browse open roles or submit a general application.</p>
    <div class="actions" style="margin:0"><a class="btn blue" href="/join">Apply now ↗</a><a class="btn" style="border-color:#fff" href="/contact">Contact us</a></div>
  </section>
</Base>

<script>
  const el = document.querySelector<HTMLElement>('.countdown');
  if (el?.dataset.start) {
    const t = new Date(el.dataset.start + ':00+02:00').getTime();
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const d = Math.max(0, t - Date.now()) / 1000;
      el.innerHTML = `<span>${pad(Math.floor(d / 86400))}<small>d</small></span><span>${pad(Math.floor(d / 3600) % 24)}<small>h</small></span><span>${pad(Math.floor(d / 60) % 60)}<small>m</small></span><span>${pad(Math.floor(d) % 60)}<small>s</small></span>`;
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
