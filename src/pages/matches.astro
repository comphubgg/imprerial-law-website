---
import Base from '../layouts/Base.astro';
import { upcoming, results } from '../data/site';
---
<Base title="Matches">
  <div class="page-head"><span class="upper">Schedule</span><h1>Match Center</h1><p class="lede">All upcoming and past matches from our teams at a glance.</p></div>
  <div class="sub-head"><h2>Scheduled</h2></div>
  <div class="rows">
    {upcoming.map((m) => (
      <div class="row">
        <div><h3>{m.team} <span style="color:var(--blue)">vs</span> {m.opponent}</h3><p>{m.event} · BO1 · Online</p></div>
        <div class="when">{m.display}<br />Europe/Berlin</div>
      </div>
    ))}
  </div>
  <div class="sub-head"><h2>Completed</h2></div>
  <div class="rows light">
    {results.map((m) => (
      <div class="row">
        <div><h3>{m.team} <span>vs</span> {m.opponent}</h3><p>{m.event} · {m.display}</p></div>
        <span class={`tag ${m.result ? m.result.toLowerCase() : 'na'}`} style={m.result === 'WIN' ? 'color:#0a8f3f' : m.result === 'LOSS' ? 'color:#d62020' : ''}>{m.result ?? '–'}</span>
      </div>
    ))}
  </div>
</Base>
