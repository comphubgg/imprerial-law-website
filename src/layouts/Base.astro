---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { org, nav, shopUrl, social } from '../data/site';

interface Props { title?: string; description?: string; }
const { title, description = org.intro } = Astro.props;
const pageTitle = title ? `${title} — ${org.name}` : `${org.name} — ${org.descriptor}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d0f" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${org.name} – home`}>
          <Logo /> <span>{org.name}</span>
        </a>
        <nav class="nav-desktop" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
          <a class="shop" href={shopUrl} target="_blank" rel="noopener">Shop ↗</a>
        </nav>
        <details class="menu">
          <summary aria-label="Menu"><span></span></summary>
          <nav class="menu-panel" aria-label="Menu">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
            <a class="shop" href={shopUrl} target="_blank" rel="noopener">Shop ↗</a>
          </nav>
        </details>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <div class="big">{org.name}</div>
          <p class="label" style="margin-top:14px">{org.descriptor} · Est. {org.founded}</p>
        </div>
        <div class="foot-links">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          {social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} {org.name}</span>
          <span>All rights reserved</span>
        </div>
      </div>
    </footer>
  </body>
</html>
