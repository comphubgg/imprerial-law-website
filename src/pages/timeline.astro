---
import Base from '../layouts/Base.astro';
import { timeline } from '../data/site';
---
<Base title="Timeline">
  <div class="page-head"><span class="upper">Timeline</span><h1>The road so far</h1><p class="lede">From a single signing to a multi-title roster — every win, deal and milestone, in order.</p></div>
  <div class="tl">
    {timeline.map((t) => (
      <article>
        <span class="badge">{t.tag}</span>
        <div class="when">{t.year}<small>{t.month ?? ''}</small></div>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </article>
    ))}
  </div>
  <section class="cta"><h2>The next milestone is already in motion.</h2><div class="actions" style="margin:0"><a class="btn blue" href="/join">Work with us ↗</a></div></section>
</Base>
