---
import Base from '../layouts/Base.astro';
import { social } from '../data/site';
---
<Base title="Contact">
  <div class="wrap page-head"><p class="label">Contact</p><h1>Get in touch</h1></div>
  <section class="section" style="border-top:0"><div class="wrap cols two">
    <div class="block"><h3>Business & partnerships</h3><p>TODO: E-Mail-Adresse eintragen</p></div>
    <div class="block"><h3>Social</h3><p>{social.map((s) => <a href={s.href} target="_blank" rel="noopener" style="margin-right:18px;color:var(--text)">{s.label} ↗</a>)}</p></div>
  </div></section>
</Base>
