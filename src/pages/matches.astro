---
import Base from '../layouts/Base.astro';
import { matches } from '../data/site';
---
<Base title="Matches">
  <div class="wrap page-head"><p class="label">Matches</p><h1>Matches</h1></div>
  <section class="section" style="border-top:0"><div class="wrap">
    {matches.length === 0 ? <p class="empty">No upcoming matches right now. Check back soon.</p> : (
      <div class="rows">
        {matches.map((m) => (
          <div class="row" style="grid-template-columns:110px 1fr auto">
            <span class="no">{m.date}</span>
            <div><h3>{m.team} vs {m.opponent}</h3><p class="game">{m.event}</p></div>
            <span class="accent">{m.result ?? ''}</span>
          </div>
        ))}
      </div>
    )}
  </div></section>
</Base>
